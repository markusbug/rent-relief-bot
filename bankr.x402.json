{
  "network": "base",
  "currency": "USDC",
  "services": {
    "notice-decoder": {
      "price": "0.02",
      "description": "Rent Relief Bot: paste anything your landlord sent you (letter, email, text). One Jev call says what kind of notice it is, how urgent, whether it threatens something landlords cannot do, and which tool to use next. Typed decisions, no text generation.",
      "methods": [
        "POST"
      ],
      "tags": [
        "tenants",
        "housing",
        "notice",
        "eviction",
        "x402",
        "jev",
        "typesafe"
      ],
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "notice": {
              "type": "string",
              "description": "The text you received, as-is (40 to 12000 chars). Letter, email, text message, or a court paper."
            },
            "state": {
              "type": "string",
              "description": "US state, e.g. CA or California"
            }
          },
          "required": [
            "notice",
            "state"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "rent_increase",
                "pay_or_quit",
                "cure_or_quit",
                "termination_or_nonrenewal",
                "court_filing",
                "entry_notice",
                "fee_or_charge",
                "deposit_statement",
                "repair_or_maintenance",
                "renewal_offer",
                "warning_or_rules",
                "other"
              ]
            },
            "kind_label": {
              "type": "string"
            },
            "kind_confidence": {
              "type": "number"
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "probability": {
                    "type": "number"
                  }
                }
              }
            },
            "urgency": {
              "type": "integer",
              "description": "0 low \u2026 3 urgent"
            },
            "urgency_label": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ]
            },
            "urgency_confidence": {
              "type": "number"
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "probability": {
                    "type": "number"
                  },
                  "why": {
                    "type": "string"
                  }
                }
              }
            },
            "what_it_means": {
              "type": "string"
            },
            "do_next": {
              "type": "string"
            },
            "get_help_now": {
              "type": [
                "string",
                "null"
              ],
              "description": "Set when the tenant should contact legal aid today"
            },
            "mentions": {
              "type": "object",
              "properties": {
                "dates": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "amounts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "day_counts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "next_tool": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "input": {
                  "type": "object"
                },
                "url": {
                  "type": "string"
                }
              }
            },
            "disclaimer": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "generated_at": {
              "type": "string"
            }
          }
        }
      }
    },
    "rent-letter": {
      "price": "0.25",
      "description": "Rent Relief Bot: generate a ready-to-send tenant letter (rent-increase negotiation, repair demand, or security-deposit return) tailored to your US state.",
      "methods": [
        "POST"
      ],
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "letter_type": {
              "type": "string",
              "enum": [
                "rent_increase",
                "repair_request",
                "deposit_return"
              ],
              "description": "Kind of letter to write"
            },
            "tenant_name": {
              "type": "string",
              "description": "Tenant's full name"
            },
            "landlord_name": {
              "type": "string",
              "description": "Landlord or property manager name"
            },
            "property_address": {
              "type": "string",
              "description": "Rental unit address"
            },
            "state": {
              "type": "string",
              "description": "US state, e.g. CA or California"
            },
            "details": {
              "type": "string",
              "description": "Plain-English description of the situation (max 4000 chars)"
            },
            "current_rent": {
              "type": "number",
              "description": "Current monthly rent in USD (optional)"
            },
            "proposed_rent": {
              "type": "number",
              "description": "Proposed new rent in USD, for rent_increase letters (optional)"
            },
            "lease_start": {
              "type": "string",
              "description": "Lease start date, YYYY-MM-DD (optional)"
            },
            "tone": {
              "type": "string",
              "enum": [
                "firm",
                "cooperative"
              ],
              "description": "Letter tone (default firm)"
            }
          },
          "required": [
            "letter_type",
            "tenant_name",
            "landlord_name",
            "property_address",
            "state",
            "details"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string"
            },
            "letter": {
              "type": "string",
              "description": "Full letter body, ready to send"
            },
            "key_points": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "next_steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "disclaimer": {
              "type": "string"
            }
          }
        }
      },
      "tags": [
        "tenant",
        "housing",
        "rent",
        "landlord",
        "letter",
        "legal-info"
      ]
    },
    "lease-clause": {
      "price": "0.10",
      "description": "Rent Relief Bot: explain a lease clause in plain English, flag red flags, and suggest edits to ask for, for your US state.",
      "methods": [
        "POST"
      ],
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "clause": {
              "type": "string",
              "description": "Verbatim lease clause text (20 to 6000 chars)"
            },
            "state": {
              "type": "string",
              "description": "US state, e.g. NY or New York"
            },
            "context": {
              "type": "string",
              "description": "Optional extra context about your situation"
            }
          },
          "required": [
            "clause",
            "state"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "plain_english": {
              "type": "string"
            },
            "what_it_means_for_you": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "red_flags": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string"
                  },
                  "issue": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  }
                }
              }
            },
            "negotiation_asks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "disclaimer": {
              "type": "string"
            }
          }
        }
      },
      "tags": [
        "tenant",
        "housing",
        "lease",
        "contract",
        "legal-info"
      ]
    },
    "lease-scan": {
      "price": "0.50",
      "description": "Rent Relief Bot: scan a whole residential lease and rank the clauses a tenant should push back on before signing. Every clause is classified by Jev (TypeSafe's System One model): typed decisions with calibrated confidence, no text generation, no hallucinated law.",
      "methods": [
        "POST"
      ],
      "tags": [
        "tenants",
        "housing",
        "lease",
        "x402",
        "jev",
        "typesafe"
      ],
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "lease": {
              "type": "string",
              "description": "Full lease text, plain text (200 to 60000 chars). Paste it as-is; the scan splits it into clauses."
            },
            "state": {
              "type": "string",
              "description": "US state, e.g. CA or California"
            }
          },
          "required": [
            "lease",
            "state"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "object",
              "properties": {
                "clauses_scanned": {
                  "type": "integer"
                },
                "flagged": {
                  "type": "integer"
                },
                "serious": {
                  "type": "integer"
                },
                "topics": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  }
                },
                "overall": {
                  "type": "string"
                }
              }
            },
            "findings": {
              "type": "array",
              "description": "Clauses that need a look, worst first",
              "items": {
                "type": "object",
                "properties": {
                  "clause_number": {
                    "type": "integer"
                  },
                  "topic": {
                    "type": "string"
                  },
                  "risk": {
                    "type": "integer",
                    "description": "0 standard \u2026 4 severe"
                  },
                  "risk_label": {
                    "type": "string",
                    "enum": [
                      "standard",
                      "minor",
                      "one-sided",
                      "serious",
                      "severe"
                    ]
                  },
                  "confidence": {
                    "type": "number"
                  },
                  "flags": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "probability": {
                          "type": "number"
                        },
                        "why": {
                          "type": "string"
                        },
                        "ask": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "excerpt": {
                    "type": "string"
                  }
                }
              }
            },
            "next_step": {
              "type": "string"
            },
            "disclaimer": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "generated_at": {
              "type": "string"
            }
          }
        }
      }
    },
    "tenant-rights": {
      "price": "0.05",
      "description": "Rent Relief Bot: quick summary of tenant protections in a US state on one topic (deposit, rent_increase, eviction, repairs, entry, lease_break, late_fees, retaliation).",
      "methods": [
        "GET"
      ],
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "description": "US state, e.g. TX or Texas"
            },
            "topic": {
              "type": "string",
              "enum": [
                "deposit",
                "rent_increase",
                "eviction",
                "repairs",
                "entry",
                "lease_break",
                "late_fees",
                "retaliation"
              ],
              "description": "Topic to summarise"
            }
          },
          "required": [
            "state",
            "topic"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            },
            "key_rules": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "common_landlord_violations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "where_to_get_help": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "type": "string"
            },
            "disclaimer": {
              "type": "string"
            }
          }
        }
      },
      "tags": [
        "tenant",
        "housing",
        "rights",
        "deposit",
        "eviction",
        "legal-info"
      ]
    }
  }
}
