{
  "name": "rent-relief-bot",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": ["web"],
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.mjs",
    "web": "npm run dev -w web",
    "build": "npm run build -w web",
    "typecheck": "npx tsc --noEmit -p web",
    "deploy:x402": "bankr x402 deploy",
    "deploy:site": "firebase deploy --only hosting",
    "serve:site": "firebase emulators:start --only hosting",
    "buyback": "node scripts/buyback.mjs",
    "buyback:dry": "DRY_RUN=1 node scripts/buyback.mjs"
  }
}
