# Wallet that owns the Bankr x402 endpoints. Revenue is paid here. Required.
VITE_OWNER_ADDRESS=0x68239eb2cf30596eb98388c41cf53c4c289480ad

# Where the site calls the services. Defaults to https://x402.bankr.bot/<VITE_OWNER_ADDRESS>.
# For local work against `npm run dev` (no payment layer):
# VITE_API_BASE=http://localhost:8787

VITE_SITE_URL=https://rentrelief.markushaas.com
VITE_GITHUB_URL=https://github.com/markusbug/rent-relief-bot
VITE_RRB_ADDRESS=0xc66b29249edffe9c436fdb0ca4e8bfbbe9affba3
# VITE_BUY_RRB_URL=            # defaults to the Bankr trade terminal for the token
# VITE_BASE_RPC_URL=           # optional private Base RPC for balance reads
# VITE_CB_WALLET_PREFERENCE=eoaOnly   # eoaOnly | all | smartWalletOnly
