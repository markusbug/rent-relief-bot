# ---- x402 handlers (set on Bankr with `bankr x402 env set KEY=VALUE`, or export locally for `npm run dev`)
LLM_GATEWAY_KEY=            # Bankr API key with the LLM gateway enabled and credits loaded
# LLM_MODEL=claude-sonnet-5   # optional override of the per-service default model
OPENROUTER_API_KEY=         # lease-scan: OpenRouter key, calls ~typesafe/jev-latest through the Decisions API
# JEV_MODEL=~typesafe/jev-latest
# JEV_API_URL=http://localhost:8788/api/alpha/decisions   # point at scripts/jev-stub.mjs for offline work
